#include<stdio.h>
#include <stdbool.h>
int main() {
    int bt[] = {4, 5, 6}, n = 3, q = 2, t = 0, i;
    while (1) {
        bool done = true;
        for (i = 0; i < n; i++) {
            if (bt[i] > 0) {
                done = false;
                if (bt[i] > q) {
                    t += q;
                    bt[i] -= q;
                } else {
                    t += bt[i];
                    bt[i] = 0;
                }
                printf("Process %d time: %d\n", i + 1, t);
            }
        }
        if (done) break;
    }
    return 0;
}
