#include <stdio.h>
#include <stdlib.h>
int main() 
{
    int requests[] = {98, 183, 37, 122, 14, 124, 65, 67}, n = 8, head = 53, seek = 0;
    printf("Initial Head Position: %d\n", head);
    for (int i = 0; i < n; i++) 
    {
        seek += abs(requests[i] - head);
        printf("%d->%d\n", head, requests[i]);
        head = requests[i];
    }
    printf("Total Seek Time: %d\n", seek);
    return 0;
}
